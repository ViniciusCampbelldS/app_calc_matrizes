<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FirstFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout_first"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tituloInstrucoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/instrucoes_entrada"
            android:textAlignment="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/matriz1_entrada"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            android:hint="@string/matriz_1"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintTop_toBottomOf="@id/tituloInstrucoes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/matriz2_entrada">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/matriz1_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4"
                android:maxLines="8" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/matriz2_entrada"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:hint="@string/matriz_2"
            app:layout_constraintWidth_max="488dp"
            app:layout_constraintTop_toTopOf="@id/matriz1_entrada"
            app:layout_constraintStart_toEndOf="@id/matriz1_entrada"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/matriz2_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4"
                android:maxLines="8" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tituloSelecioneOperacao1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/qual_linha"
            app:layout_constraintTop_toBottomOf="@id/matriz1_entrada"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/selecioneOperacao1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:entries="@array/tipo_de_operacao"
            app:layout_constraintTop_toBottomOf="@id/tituloSelecioneOperacao1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tituloSelecioneOperacao2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/selecione_operacao"
            app:layout_constraintTop_toBottomOf="@id/selecioneOperacao1"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/selecioneOperacao2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:entries="@array/operacoes_matriz"
            app:layout_constraintTop_toBottomOf="@id/tituloSelecioneOperacao2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/selecioneOperacao3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:entries="@array/operacoes_linha"
            app:layout_constraintTop_toBottomOf="@id/tituloSelecioneOperacao2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/numero_linha_entrada"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="6dp"
            android:hint="@string/indice_origem"
            app:layout_constraintTop_toBottomOf="@id/selecioneOperacao2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/numero_linha_substituida_entrada">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/numero_linha_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/numero_linha_substituida_entrada"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:hint="@string/indice_destino"
            app:layout_constraintTop_toBottomOf="@id/selecioneOperacao2"
            app:layout_constraintStart_toEndOf="@id/numero_linha_entrada"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/numero_linha_substituida_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/botao_resolver"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/resolver_operacao"
            app:layout_constraintTop_toBottomOf="@id/numero_linha_entrada"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/resultado_saida"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/resultado"
            app:layout_constraintTop_toBottomOf="@id/botao_resolver"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/resultado_texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:textIsSelectable="true" />
        </com.google.android.material.textfield.TextInputLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
