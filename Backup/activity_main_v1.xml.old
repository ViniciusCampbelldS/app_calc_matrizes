<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <View
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:background="@color/light_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titulo_principal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculadora_de_matrizes"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar" />

        <TextView
            android:id="@+id/instrucoes_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/instrucoes1"
            android:textAlignment="center"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titulo_principal"
            tools:ignore="VisualLintLongText" />

        <EditText
            android:id="@+id/matriz_a_entrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="5"
            android:textColor="@color/cinza_muito_escuro"
            android:hint="@string/digite_primeira_matriz"
            app:layout_constraintEnd_toStartOf="@+id/troca_matrizes_botao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/instrucoes_texto"
            tools:ignore="VisualLintTextFieldSize" />

        <ImageButton
            android:id="@+id/troca_matrizes_botao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/trocar_ordem"
            android:hint="@string/trocar_ordem"
            android:src="@drawable/baseline_swap_horiz_24"
            app:layout_constraintBottom_toBottomOf="@+id/matriz_a_entrada"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/matriz_a_entrada"
            tools:ignore="ContentDescription,TouchTargetSizeCheck" />

        <EditText
            android:id="@+id/matriz_b_entrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="5"
            android:textColor="@color/cinza_muito_escuro"
            android:hint="@string/digite_segunda_matriz"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/troca_matrizes_botao"
            app:layout_constraintTop_toTopOf="@+id/matriz_a_entrada"
            tools:ignore="VisualLintTextFieldSize" />

        <TextView
            android:id="@+id/tipo_operacao_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/qual_tipo_operacao"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/matriz_a_entrada" />

        <RadioGroup
            android:id="@+id/tipo_operacao_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tipo_operacao_titulo">

            <RadioButton
                android:id="@+id/operacao_matriz_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/operacao_sobre_matriz"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/operacao_linha_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/operacao_sobre_linha"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/operacao_coluna_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/operacao_sobre_coluna"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />
        </RadioGroup>

        <TextView
            android:id="@+id/qual_operacao_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qual_operacao_spinner"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tipo_operacao_radio" />

        <Spinner
            android:id="@+id/qual_operacao_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qual_operacao_titulo"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/coluna_operacao_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:text="@string/num_coluna_operacao"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/qual_operacao_spinner" />

        <EditText
            android:id="@+id/coluna_operacao_entrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:importantForAutofill="no"
            android:inputType="numberSigned|number"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coluna_operacao_titulo" />

        <TextView
            android:id="@+id/coluna_substituida_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:importantForAutofill="no"
            android:text="@string/num_coluna_substituida"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coluna_operacao_entrada" />

        <EditText
            android:id="@+id/coluna_substituida_entrada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:inputType="numberSigned|number"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coluna_substituida_titulo"
            tools:ignore="Autofill" />

        <TextView
            android:id="@+id/metodo_substituicao_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:text="@string/metodo_substituicao_texto"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/coluna_substituida_entrada" />

        <RadioGroup
            android:id="@+id/metodo_substituicao_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/metodo_substituicao_titulo">

            <RadioButton
                android:id="@+id/soma_ao_resultado_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/somar_ao_resultado"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/multiplica_pelo_resultado_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/multiplicar_pelo_resultado"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/divide_pelo_resultado_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/dividir_pelo_resultado"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

            <RadioButton
                android:id="@+id/apenas_substitui_botao"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="arial"
                android:text="@string/apenas_substituir_resultado"
                android:textSize="14sp"
                tools:ignore="TouchTargetSizeCheck" />

        </RadioGroup>

        <Button
            android:id="@+id/calcular_botao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calcular"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/metodo_substituicao_radio" />

        <TextView
            android:id="@+id/resultados_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/resultados_string"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calcular_botao" />

        <!-- Tabela do Resultado 1 -->
        <TextView
            android:id="@+id/resultados_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Resultado 1"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/coluna_substituida_entrada"
            app:layout_constraintStart_toStartOf="parent" />

        <TableLayout
            android:id="@+id/resultado1_tabela"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:stretchColumns="*"
            app:layout_constraintTop_toBottomOf="@id/resultados_titulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tabela do Resultado 2 -->
        <TextView
            android:id="@+id/outros_resultados_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Outros Resultados"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/resultado1_tabela"
            app:layout_constraintStart_toStartOf="parent" />

        <TableLayout
            android:id="@+id/resultado2_tabela"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:stretchColumns="*"
            app:layout_constraintTop_toBottomOf="@id/outros_resultados_titulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tabela do Resultado 3 -->
        <TableLayout
            android:id="@+id/resultado3_tabela"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:stretchColumns="*"
            app:layout_constraintTop_toBottomOf="@id/resultado2_tabela"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:text="@string/outros_resultados_string"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resultado3_tabela" />
            android:id="@+id/exibir_resultado2"
            layout="@layout/resultado2_tabela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resultados_titulo" />


        <include
            android:id="@+id/exibir_resultado3"
            layout="@layout/resultado3_tabela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/resultados_titulo" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_end="0dp"
            app:layout_constraintTop_toBottomOf="@id/qual_operacao_spinner" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>